<Project>
  <!-- Shared properties for all projects in the solution -->
  <PropertyGroup>
    <Authors>Moshiur</Authors>
    <Company>Syed</Company>
    <Product>Syed.Messaging</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/moshiur/Syed.Messaging</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/moshiur/Syed.Messaging</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright © 2025 Moshiur. All rights reserved.</Copyright>
    <PackageTags>messaging;rabbitmq;kafka;azure-service-bus;dotnet;cqrs;saga;outbox;inbox</PackageTags>

    <!-- Default: not packable. Library projects opt in. -->
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Source link for better debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Include README.md in NuGet packages -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
